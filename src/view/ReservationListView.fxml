<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.ReservationListController"
            prefHeight="400.0" prefWidth="400.0">
    <TableView fx:id="ReservationTable" VBox.vgrow="NEVER" editable="false">
            <columns>
                <TableColumn fx:id="ReservationBuildingColumn" text="Name" prefWidth="80"></TableColumn>
                <TableColumn fx:id="DateColumn" text="Date" prefWidth="80"></TableColumn >
                <TableColumn fx:id="StartTimeColumn" text="Start Time" prefWidth="80"></TableColumn>
                <TableColumn fx:id="EndTimeColumn" text="End Time" prefWidth="80"></TableColumn>
                <TableColumn fx:id="FeaturesColumn" text="Features" prefWidth="80"></TableColumn>
            </columns>
    </TableView>
</VBox>
