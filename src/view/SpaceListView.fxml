<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.SpaceListController"
            prefHeight="400.0" prefWidth="450">
    <TextField fx:id="spaceFeatures" editable="false">

    </TextField>
    <TableView fx:id="SpaceTable" VBox.vgrow="NEVER" editable="false" layoutX="50" layoutY="50" >
        <columns>
            <TableColumn fx:id="NameColumn" text="Name" prefWidth="133"> </TableColumn>
            <TableColumn fx:id="BuildingColumn" text="Building" prefWidth="134"> </TableColumn>
            <TableColumn fx:id="CapacityColumn" text="Capacity" prefWidth="133"> </TableColumn>
        </columns>
    </TableView>

</VBox>
